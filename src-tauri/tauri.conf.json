{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Warden",
  "version": "0.1.4",
  "identifier": "com.jiangcheng.repotoryagent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Warden",
        "width": 480,
        "height": 760,
        "minWidth": 380,
        "minHeight": 520,
        "focus": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "shadow": true
      },
      {
        "label": "companion",
        "title": "Warden",
        "url": "index.html?surface=companion",
        "width": 168,
        "height": 196,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A local copilot that reads the Cinder memory layer",
    "longDescription": "A local copilot: chat with a local model about the project you have open, and let Cinder supply the memory over MCP.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
