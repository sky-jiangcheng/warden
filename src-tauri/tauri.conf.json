{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Repotory Agent Shell",
  "version": "0.1.0",
  "identifier": "com.jiangcheng.repotoryagentshell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Repotory Agent Shell",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local Agent shell on top of the Repotory memory layer",
    "longDescription": "A local Agent entry point: chat with a local model about the project you have open, and let Repotory supply the memory over MCP.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
